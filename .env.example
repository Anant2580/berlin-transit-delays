# Copy this file to .env and change the password if you like.
POSTGRES_DB=transit
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit

# How often to collect (seconds) and how far ahead each request looks (minutes)
POLL_INTERVAL_SECONDS=300
LOOKAHEAD_MINUTES=10

# Read-only database user for the dashboard. deploy/update.sh fills this in automatically.
DASHBOARD_DB_PASSWORD=
