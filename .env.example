# Copy this file to .env and change the password if you like.
POSTGRES_DB=transit
POSTGRES_USER=transit
POSTGRES_PASSWORD=transit

# How often to collect (seconds) and how far ahead each request looks (minutes)
POLL_INTERVAL_SECONDS=300
LOOKAHEAD_MINUTES=10

# Read-only database user for the dashboard. deploy/update.sh fills this in automatically.
DASHBOARD_DB_PASSWORD=

# Which optional parts to run: "collector" (standalone collector, default),
# "public,airflow" on the cloud server (HTTPS dashboard + Airflow runs the collection).
# deploy/update.sh sets this and creates the Airflow secrets below automatically.
COMPOSE_PROFILES=collector
AIRFLOW_DB_PASSWORD=
AIRFLOW_ADMIN_PASSWORD=
AIRFLOW_JWT_SECRET=
AIRFLOW_FERNET_KEY=
