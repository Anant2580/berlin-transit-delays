# Public HTTPS entry point for the dashboard (only started with COMPOSE_PROFILES=public).
# Caddy gets a free Let's Encrypt certificate for DASHBOARD_HOST automatically.
{$DASHBOARD_HOST} {
	encode gzip
	reverse_proxy dashboard:8501
}

# Other small apps on this server bring their own site file (e.g. /opt/caddy-sites/wareneinsatz.caddy)
# and join the shared Docker network "edge". This stack's data stays out of their reach.
import sites/*.caddy
